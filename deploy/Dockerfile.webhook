FROM python:3.11-slim

WORKDIR /app

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=120 \
    PYTHONUNBUFFERED=1

COPY requirements.txt .
COPY deploy/pip_install.sh /tmp/pip_install.sh
RUN chmod +x /tmp/pip_install.sh && /tmp/pip_install.sh requirements.txt

COPY src/ ./src/

CMD ["python", "-m", "src.api.webhook"]
